{
  "name": "riscov",
  "version": "0.1.0",
  "description": "Riscov — an LLM agent that watches on-chain assets and reasons about their risk in context",
  "type": "module",
  "private": true,
  "scripts": {
    "check": "tsx src/cli.ts",
    "watch": "tsx src/scheduler.ts",
    "test:scenarios": "tsx src/test/scenarios.ts",
    "typecheck": "tsc --noEmit",
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "deploy:testnet": "hardhat run scripts/deploy.cts --network xlayerTestnet",
    "deploy:mainnet": "hardhat run scripts/deploy.cts --network xlayerMainnet",
    "deploy:demo-market:testnet": "hardhat run scripts/deployDemoMarket.cts --network xlayerTestnet",
    "deploy:demo-market:mainnet": "hardhat run scripts/deployDemoMarket.cts --network xlayerMainnet",
    "read-ledger": "tsx src/readLedger.ts",
    "demo": "tsx src/demo.ts",
    "mcp:server": "tsx src/mcp/server.ts",
    "mcp:http-server": "tsx src/mcp/httpServer.ts",
    "mcp:test-client": "tsx src/mcp/testClient.ts",
    "paid:server": "tsx src/paidServer.ts",
    "paid:client": "tsx src/paidClient.ts",
    "register:erc8004:mainnet": "hardhat run scripts/registerErc8004.cts --network xlayerMainnet",
    "vercel-build": "esbuild src/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.mjs && esbuild src/mcpVercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/mcp.mjs && npm --prefix web install && npm --prefix web run build"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@okxweb3/x402-fetch": "^0.1.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4",
    "express": "^4.22.2",
    "openai": "^4.77.0",
    "viem": "^2.55.13"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@types/chai": "^4.3.20",
    "@types/express": "^4.17.25",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "chai": "^4.5.0",
    "esbuild": "^0.28.2",
    "hardhat": "^2.29.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
