# --- LLM (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- X Layer RPC (Phase 0) ---
# testnet chain id 1952, mainnet chain id 196 — double check before every deploy
XLAYER_NETWORK=testnet
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# --- Optional: OKLink explorer API (Phase 0 — OKX developer portal) ---
# Without this, getAuditStatus falls back to a raw on-chain bytecode check
# instead of a real verification/audit lookup.
OKLINK_API_KEY=

# --- Watcher scheduler ---
WATCH_INTERVAL_MINUTES=5

# --- Phase 2: The Ledger (on-chain contract) ---
# The Watcher's wallet: deploys RiscovLedger (becomes its immutable `watcher`
# address) AND signs submitRating() calls afterward. Needs testnet gas from
# the X Layer faucet before deploying or submitting.
WATCHER_PRIVATE_KEY=
# Filled in after `npm run deploy:testnet` — paste the deployed address here.
LEDGER_CONTRACT_ADDRESS=

# --- Phase 3: DemoMarket (consumer demo) ---
# Filled in after `npm run deploy:demo-market:testnet`.
DEMO_MARKET_CONTRACT_ADDRESS=
DEMO_ASSET_SYMBOL=FROG

# --- Phase 4: MCP + x402 pay-per-call (Agent-to-MCP distribution) ---
# Paid HTTP endpoint (src/paidServer.ts), gated by x402 on Base Sepolia
# testnet by default. Swap X402_NETWORK to eip155:8453 for Base mainnet.
X402_PAY_TO_ADDRESS=
X402_PAY_TO_PRIVATE_KEY=
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PRICE_USDC=$0.01
PAID_SERVER_PORT=4021
PAID_SERVER_URL=http://localhost:4021/check-risk
# The throwaway "another agent" paying wallet (src/paidClient.ts) — needs
# testnet USDC on Base Sepolia, no ETH required (x402's exact scheme is
# gasless for the payer via EIP-3009).
TEST_AGENT_PRIVATE_KEY=

# --- Phase 4: ERC-8004 agent identity (prepared, NOT auto-run — mainnet only) ---
# IdentityRegistry is deployed at the same address across 30+ chains
# including X Layer mainnet, but NOT X Layer testnet (verified on-chain).
# RISCOV_AGENT_URI should point at a hosted description of the Watcher
# agent (capabilities, service endpoints) before running scripts/registerErc8004.cts.
RISCOV_AGENT_URI=
