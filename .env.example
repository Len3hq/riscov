# --- LLM (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- X Layer RPC (Phase 0) ---
# testnet chain id 1952, mainnet chain id 196 — double check before every deploy
XLAYER_NETWORK=testnet
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
XLAYER_MAINNET_RPC=https://rpc.xlayer.tech

# --- Watcher scheduler ---
WATCH_INTERVAL_MINUTES=5

# --- Phase 2: The Ledger (on-chain contract) ---
# The Watcher's wallet: deploys RiscovLedger (becomes its immutable `watcher`
# address) AND signs submitRating() calls afterward. Needs testnet gas from
# the X Layer faucet before deploying or submitting.
WATCHER_PRIVATE_KEY=
# Filled in after `npm run deploy:testnet` — paste the deployed address here.
LEDGER_CONTRACT_ADDRESS=

# --- Phase 3: DemoMarket (consumer demo) ---
# Filled in after `npm run deploy:demo-market:testnet`.
DEMO_MARKET_CONTRACT_ADDRESS=
DEMO_ASSET_SYMBOL=DEMO

# --- Phase 4: MCP over streamable HTTP (local/VPS hosting only) ---
# Not needed on Vercel — src/mcpVercelEntry.ts binds to the platform's own
# port. Only used by `npm run mcp:http-server` (src/mcp/httpServer.ts).
MCP_SERVER_PORT=4022

# --- OKX Onchain OS Developer Portal credentials (Phase 0) ---
# X Layer only — no alternate-chain fallback. Register a project at the OKX
# Onchain OS developer portal (Connect Wallet -> Create API key) to get
# these. Two things use them: (1) getAuditStatus.ts calls the Onchain OS
# Market API (token/advanced-info — risk tags, holder concentration) with
# manual OK-ACCESS-* HMAC signing (src/tools/getAuditStatus.ts); without
# these it falls back to an honest on-chain bytecode-only check instead.
# (2) x402 pay-per-call below, where signing is handled internally by
# @okxweb3/x402-core's OKXFacilitatorClient instead. There is no separate
# "OKLink" account needed for anything in this project — oklink.com's own
# Explorer API self-serve signup has been unavailable since that product's
# API was suspended (May 2025); its functionality is covered by this same
# Onchain OS Market API instead, confirmed with a live signed call.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# Paid HTTP endpoint (src/paidServer.ts), gated by x402 on X Layer.
X402_PAY_TO_ADDRESS=
X402_PAY_TO_PRIVATE_KEY=
# CAIP-2 id: eip155:196 (mainnet) or eip155:1952 (testnet).
X402_NETWORK=
# Defaults to https://web3.okx.com in code if left unset.
X402_FACILITATOR_URL=
X402_PRICE_USDC=$0.01
PAID_SERVER_PORT=4021
PAID_SERVER_URL=http://localhost:4021/check-risk
# The throwaway "another agent" paying wallet (src/paidClient.ts).
TEST_AGENT_PRIVATE_KEY=

# --- Phase 4: ERC-8004 agent identity (prepared, NOT auto-run — mainnet only) ---
# IdentityRegistry is deployed at the same address across 30+ chains
# including X Layer mainnet, but NOT X Layer testnet (verified on-chain).
# RISCOV_AGENT_URI should point at a hosted description of the Watcher
# agent (capabilities, service endpoints) before running scripts/registerErc8004.cts.
RISCOV_AGENT_URI=
